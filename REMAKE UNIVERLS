--==============================================================--
-- TOGGLE
--==============================================================--

local function Toggle(Name,Y,Getter,Setter)

    local Button = Instance.new("TextButton")

    Button.Size = UDim2.fromOffset(240,35)
    Button.Position = UDim2.fromOffset(20,Y)
    Button.BackgroundColor3 = Config.Button
    Button.TextColor3 = Config.White
    Button.Font = Enum.Font.GothamBold
    Button.TextSize = 13
    Button.AutoButtonColor = false
    Button.Parent = Content

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0,8)
    Corner.Parent = Button

    local function Update()

        local State = Getter()

        Button.Text =
            Name .. " : " ..
            (State and "ON" or "OFF")

        Button.BackgroundColor3 =
            State and Config.Green or Config.Button

        Button.TextColor3 =
            State and Color3.new(0,0,0) or Config.White

    end

    Button.Activated:Connect(function()

        Setter(not Getter())
        Update()

    end)

    Update()

end

