--==============================================================--
-- ESP BOX
--==============================================================--

local function NewESPLine(Parent)

    local Line = Instance.new("Frame")

    Line.BorderSizePixel = 0
    Line.BackgroundColor3 = Config.Green
    Line.ZIndex = 50
    Line.Parent = Parent

    return Line
end

local function RemoveESP(Player)

    local Data = ESPObjects[Player]

    if Data then

        if Data.Connection then
            Data.Connection:Disconnect()
        end

        if Data.Gui then
            Data.Gui:Destroy()
        end

    end

    ESPObjects[Player] = nil

end

local function CreateESP(Player,Character)

    if Player == LocalPlayer then
        return
    end

    RemoveESP(Player)

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    if not Humanoid or not Root then
        return
    end

    local Holder = Instance.new("Frame")

    Holder.Name = "ESP_BOX"
    Holder.BackgroundTransparency = 1
    Holder.BorderSizePixel = 0
    Holder.Visible = false
    Holder.ZIndex = 50
    Holder.Parent = Gui

    local Top = NewESPLine(Holder)
    local Bottom = NewESPLine(Holder)
    local Left = NewESPLine(Holder)
    local Right = NewESPLine(Holder)

    local Text = Instance.new("TextLabel")

    Text.BackgroundTransparency = 1
    Text.TextColor3 = Config.White
    Text.TextStrokeTransparency = 0
    Text.Font = Enum.Font.GothamBold
    Text.TextSize = 13
    Text.Size = UDim2.fromOffset(200,60)
    Text.Position = UDim2.new(.5,0,0,0)
    Text.AnchorPoint = Vector2.new(.5,1)
    Text.ZIndex = 51
    Text.Parent = Holder

    ESPObjects[Player] = {
        Gui = Holder
    }

    ESPObjects[Player].Connection =
        RunService.RenderStepped:Connect(function()

            if not Character.Parent then
                Holder.Visible = false
                return
            end

            local Camera =
                workspace.CurrentCamera

            if not Camera then
                return
            end

            if not Config.ESP_ALL then
                Holder.Visible = false
                return
            end

            -- Fixed box based on character root + humanoid height
            local Height =
                math.max(
                    Humanoid.HipHeight * 2 +
                    4,
                    5
                )

            local Width = Height * .45

            local TopWorld =
                Root.Position +
                Vector3.new(0,Height/2,0)

            local BottomWorld =
                Root.Position -
                Vector3.new(0,Height/2,0)

            local TopPoint,TopVisible =
                Camera:WorldToViewportPoint(TopWorld)

            local BottomPoint,BottomVisible =
                Camera:WorldToViewportPoint(BottomWorld)

            if not TopVisible and not BottomVisible then
                Holder.Visible = false
                return
            end

            local Center =
                Camera:WorldToViewportPoint(
                    Root.Position
                )

            local PixelHeight =
                math.abs(
                    TopPoint.Y -
                    BottomPoint.Y
                )

            if PixelHeight < 10 then
                Holder.Visible = false
                return
            end

            local PixelWidth =
                PixelHeight * .45

            Holder.Position =
                UDim2.fromOffset(
                    Center.X,
                    (TopPoint.Y+BottomPoint.Y)/2
                )

            Holder.Size =
                UDim2.fromOffset(
                    PixelWidth,
                    PixelHeight
                )

            local ShowBox =
                Config.ESP_BOX

            Top.Visible = ShowBox
            Bottom.Visible = ShowBox
            Left.Visible = ShowBox
            Right.Visible = ShowBox

            Top.Size =
                UDim2.new(1,0,0,2)

            Top.Position =
                UDim2.fromOffset(0,0)

            Bottom.Size =
                UDim2.new(1,0,0,2)

            Bottom.Position =
                UDim2.new(0,0,1,-2)

            Left.Size =
                UDim2.new(0,2,1,0)

            Left.Position =
                UDim2.fromOffset(0,0)

            Right.Size =
                UDim2.new(0,2,1,0)

            Right.Position =
                UDim2.new(1,-2,0,0)

            local Info = {}

            if Config.ESP_NAME then
                table.insert(
                    Info,
                    Player.DisplayName
                )
            end

            if Config.ESP_HEALTH then
                table.insert(
                    Info,
                    "HP: "..math.floor(Humanoid.Health)
                )
            end

            if Config.ESP_DISTANCE then

                local MyCharacter =
                    LocalPlayer.Character

                local MyRoot =
                    MyCharacter
                    and MyCharacter:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if MyRoot then

                    local Distance =
                        (
                            Root.Position -
                            MyRoot.Position
                        ).Magnitude

                    table.insert(
                        Info,
                        math.floor(Distance)
                        .." studs"
                    )

                end

            end

            Text.Text =
                table.concat(Info,"\n")

            Text.Visible =
                #Info > 0

            Holder.Visible =
                ShowBox or #Info > 0

        end)

end

--==============================================================--
-- PLAYER SETUP
--==============================================================--

local function SetupPlayer(Player)

    if Player == LocalPlayer then
        return
    end

    Player.CharacterAdded:Connect(function(Character)

        task.wait(.5)

        CreateESP(Player,Character)

    end)

    if Player.Character then

        task.spawn(function()
            CreateESP(Player,Player.Character)
        end)

    end

end

for _,Player in ipairs(
    Players:GetPlayers()
) do
    SetupPlayer(Player)
end

Players.PlayerAdded:Connect(SetupPlayer)

Players.PlayerRemoving:Connect(function(Player)
    RemoveESP(Player)
end)

