--==============================================================--
-- 2D ESP BOX
--==============================================================--

local function CreateLine(Parent)

    local Line = Instance.new("Frame")

    Line.BackgroundColor3 = Config.Green
    Line.BorderSizePixel = 0
    Line.ZIndex = 20
    Line.Parent = Parent

    return Line
end

local function CreateESP(Player,Character)

    if Player == LocalPlayer then
        return
    end

    if ESPObjects[Player] then
        if ESPObjects[Player].Connection then
            ESPObjects[Player].Connection:Disconnect()
        end

        if ESPObjects[Player].Holder then
            ESPObjects[Player].Holder:Destroy()
        end
    end

    local Root =
        Character:FindFirstChild("HumanoidRootPart")

    local Head =
        Character:FindFirstChild("Head")

    local Humanoid =
        Character:FindFirstChildOfClass("Humanoid")

    if not Root or not Head or not Humanoid then
        return
    end

    --==========================================================--
    -- HOLDER
    --==========================================================--

    local Holder = Instance.new("Frame")

    Holder.Name = "DAWN_ESP_2D"
    Holder.BackgroundTransparency = 1
    Holder.AnchorPoint = Vector2.new(0.5,0.5)
    Holder.Visible = false
    Holder.ZIndex = 20
    Holder.Parent = Gui

    --==========================================================--
    -- 4 THANH
    --==========================================================--

    local Top = CreateLine(Holder)
    local Bottom = CreateLine(Holder)
    local Left = CreateLine(Holder)
    local Right = CreateLine(Holder)

    --==========================================================--
    -- TEXT
    --==========================================================--

    local Text = Instance.new("TextLabel")

    Text.BackgroundTransparency = 1
    Text.TextColor3 = Config.White
    Text.TextStrokeTransparency = 0
    Text.Font = Enum.Font.GothamBold
    Text.TextSize = 14
    Text.TextXAlignment = Enum.TextXAlignment.Center
    Text.AnchorPoint = Vector2.new(0.5,1)
    Text.Position = UDim2.new(0.5,0,0, -4)
    Text.Size = UDim2.fromOffset(220,60)
    Text.Parent = Holder

    ESPObjects[Player] = {
        Holder = Holder,
        Connection = nil
    }

    ESPObjects[Player].Connection =
        RunService.RenderStepped:Connect(function()

            if not Character.Parent then
                Holder.Visible = false
                return
            end

            Camera = workspace.CurrentCamera

            if not Camera then
                return
            end

            if not Config.ESP_ALL then
                Holder.Visible = false
                return
            end

            --==================================================--
            -- TÍNH KHUNG 2D
            --==================================================--

            local CF, Size =
                Character:GetBoundingBox()

            local Half = Size / 2

            local Points = {}

            for X = -1,1,2 do
                for Y = -1,1,2 do
                    for Z = -1,1,2 do

                        local WorldPoint =
                            CF.Position
                            +
                            CF.RightVector * Half.X * X
                            +
                            CF.UpVector * Half.Y * Y
                            +
                            CF.LookVector * Half.Z * Z

                        local ScreenPoint, OnScreen =
                            Camera:WorldToViewportPoint(
                                WorldPoint
                            )

                        if OnScreen then
                            table.insert(
                                Points,
                                Vector2.new(
                                    ScreenPoint.X,
                                    ScreenPoint.Y
                                )
                            )
                        end
                    end
                end
            end

            if #Points == 0 then
                Holder.Visible = false
                return
            end

            local MinX = math.huge
            local MaxX = -math.huge
            local MinY = math.huge
            local MaxY = -math.huge

            for _,Point in ipairs(Points) do

                MinX = math.min(MinX,Point.X)
                MaxX = math.max(MaxX,Point.X)

                MinY = math.min(MinY,Point.Y)
                MaxY = math.max(MaxY,Point.Y)

            end

            local Width = MaxX - MinX
            local Height = MaxY - MinY

            local CenterX = (MinX + MaxX) / 2
            local CenterY = (MinY + MaxY) / 2

            Holder.Position =
                UDim2.fromOffset(
                    CenterX,
                    CenterY
                )

            Holder.Size =
                UDim2.fromOffset(
                    math.max(Width,20),
                    math.max(Height,30)
                )

            Holder.Visible =
                Config.ESP_BOX
                or
                Config.ESP_NAME
                or
                Config.ESP_HEALTH
                or
                Config.ESP_DISTANCE

            --==================================================--
            -- 4 THANH BOX
            --==================================================--

            Top.Visible = Config.ESP_BOX
            Bottom.Visible = Config.ESP_BOX
            Left.Visible = Config.ESP_BOX
            Right.Visible = Config.ESP_BOX

            Top.Size =
                UDim2.new(1,0,0,2)

            Top.Position =
                UDim2.fromOffset(0,0)

            Bottom.Size =
                UDim2.new(1,0,0,2)

            Bottom.Position =
                UDim2.new(0,0,1,-2)

            Left.Size =
                UDim2.new(0,2,1,0)

            Left.Position =
                UDim2.fromOffset(0,0)

            Right.Size =
                UDim2.new(0,2,1,0)

            Right.Position =
                UDim2.new(1,-2,0,0)

            --==================================================--
            -- TEXT ESP
            --==================================================--

            local Info = {}

            if Config.ESP_NAME then

                table.insert(
                    Info,
                    Player.DisplayName
                )

            end

            if Config.ESP_HEALTH then

                table.insert(
                    Info,
                    "HP: "
                    ..
                    math.floor(
                        Humanoid.Health
                    )
                )

            end

            if Config.ESP_DISTANCE then

                local MyCharacter =
                    LocalPlayer.Character

                local MyRoot =
                    MyCharacter
                    and
                    MyCharacter:FindFirstChild(
                        "HumanoidRootPart"
                    )

                if MyRoot then

                    local Distance =
                        (
                            Root.Position
                            -
                            MyRoot.Position
                        ).Magnitude

                    table.insert(
                        Info,
                        math.floor(Distance)
                        ..
                        " studs"
                    )

                end

            end

            Text.Text =
                table.concat(
                    Info,
                    "\n"
                )

            Text.Visible =
                Config.ESP_NAME
                or
                Config.ESP_HEALTH
                or
                Config.ESP_DISTANCE

        end)

end

--==============================================================--
-- REMOVE ESP
--==============================================================--

local function RemoveESP(Player)

    local Data = ESPObjects[Player]

    if not Data then
        return
    end

    if Data.Connection then
        Data.Connection:Disconnect()
    end

    if Data.Holder then
        Data.Holder:Destroy()
    end

    ESPObjects[Player] = nil

end

--==============================================================--
-- PLAYER SETUP
--==============================================================--

local function SetupPlayer(Player)

    if Player == LocalPlayer then
        return
    end

    Player.CharacterAdded:Connect(function(Character)

        task.wait(0.5)

        CreateESP(
            Player,
            Character
        )

    end)

    if Player.Character then

        task.spawn(function()

            CreateESP(
                Player,
                Player.Character
            )

        end)

    end

end

for _,Player in ipairs(
    Players:GetPlayers()
) do

    SetupPlayer(Player)

end

Players.PlayerAdded:Connect(
    SetupPlayer
)

Players.PlayerRemoving:Connect(
    RemoveESP
)

