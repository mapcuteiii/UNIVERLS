--==============================================================--
-- TOGGLE
--==============================================================--

local function CreateToggle(Name,Y,Getter,Setter)

    local Button = Instance.new("TextButton")

    Button.Size = UDim2.fromOffset(240,35)
    Button.Position = UDim2.fromOffset(20,Y)
    Button.BackgroundColor3 = Config.Button
    Button.TextColor3 = Config.White
    Button.TextSize = 13
    Button.Font = Enum.Font.GothamBold
    Button.AutoButtonColor = false
    Button.Parent = Content

    local Corner = Instance.new("UICorner")
    Corner.CornerRadius = UDim.new(0,8)
    Corner.Parent = Button

    local function Update()

        if Getter() then
            Button.Text = Name .. " : ON"
            Button.BackgroundColor3 = Config.Green
            Button.TextColor3 = Color3.new(0,0,0)
        else
            Button.Text = Name .. " : OFF"
            Button.BackgroundColor3 = Config.Button
            Button.TextColor3 = Config.White
        end

    end

    Button.Activated:Connect(function()

        Setter(not Getter())
        Update()

    end)

    Update()

    return Button
end

